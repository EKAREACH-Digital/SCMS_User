# Copy to `.env` (git-ignored) and fill in. Loaded at startup by AppConfig.
#
# Everything here is bundled into the app and readable by anyone who unpacks
# it — only public identifiers belong here, never a secret.

# Backend server URL including any path prefix, WITHOUT the API version —
# every route in ApiConfig carries it (ApiConfig.version, e.g. /v1).
#   iOS simulator:     http://localhost:3000/api
#   Android emulator:  http://10.0.2.2:3000/api
#   Physical phone:    http://<your-mac-lan-ip>:3000/api   (ipconfig getifaddr en0)
#   Production:        https://api.smartcanteen.cadt.edu.kh
API_BASE_URL=http://localhost:3000/api

# Google Sign-In. SERVER_CLIENT_ID is the backend's "Web application" OAuth
# client (backend GOOGLE_CLIENT_ID). IOS_CLIENT_ID is the iOS OAuth client; its
# reversed form must also be a URL scheme in ios/Runner/Info.plist.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Microsoft (MSAL). Must match the Azure app registration and the backend's
# MICROSOFT_TENANT_ID.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
# msauth://<android applicationId>/<url-encoded signature hash> — tied to the
# signing key, so debug and release builds need different values.
MICROSOFT_ANDROID_REDIRECT_URI=
